# =============================================================================
# AgentSmith Environment Configuration
# =============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Generate secure values for all secrets (see bottom of file)
# 3. Update URLs if deploying to a custom domain
# 4. Secure the file: chmod 600 .env
#
# SECURITY WARNING:
# - Never commit .env to version control
# - Use strong, unique values for all secrets
# - Rotate secrets periodically in production
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Options: development, production
NODE_ENV=production
APP_NAME=AgentSmith

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=4000
HOST=0.0.0.0

# URLs (update for your domain in production)
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WEBHOOK_URL=http://localhost:4000/webhooks

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# Admin Panel
ADMIN_PORT=3001

# CORS (comma-separated list of allowed origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=agentsmith
DB_USERNAME=agentsmith
# SECURITY: Generate with: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# =============================================================================
# REDIS (Queues & Caching)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
# SECURITY: Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD
REDIS_DB=0

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================
# JWT_SECRET: Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=7d

# JWT_REFRESH_SECRET: Generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_64_CHAR_HEX_STRING
JWT_REFRESH_EXPIRES_IN=30d

# ENCRYPTION_KEY: MUST be exactly 32 characters
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY=CHANGE_ME_EXACTLY_32_CHARACTERS_

# SESSION_SECRET: Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_GENERATE_64_CHAR_HEX_STRING

# =============================================================================
# RATE LIMITING
# =============================================================================
# General API rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Auth endpoint rate limiting (stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Execution rate limiting
EXECUTION_RATE_LIMIT_MAX=50

# =============================================================================
# WORKER CONFIGURATION
# =============================================================================
WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY=5000
EXECUTION_TIMEOUT=3600000

# =============================================================================
# LOGGING
# =============================================================================
# Levels: debug, info, warn, error
LOG_LEVEL=info
LOG_FORMAT=json
AUDIT_LOG_ENABLED=true

# =============================================================================
# FILE STORAGE
# =============================================================================
STORAGE_TYPE=local
STORAGE_PATH=./storage

# AWS S3 (optional - for cloud storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# =============================================================================
# EMAIL NOTIFICATIONS (optional)
# =============================================================================
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@agentsmith.local
SMTP_FROM_NAME=AgentSmith

# =============================================================================
# SSO / OAUTH PROVIDERS (optional)
# =============================================================================
# Enable SSO authentication
SSO_ENABLED=false

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft/Azure AD OAuth
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Okta OAuth
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DOMAIN=

# Generic OIDC Provider
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER_URL=

# =============================================================================
# EXTERNAL AI SERVICES (optional)
# =============================================================================
# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google AI
GOOGLE_AI_API_KEY=

# =============================================================================
# MONITORING (optional)
# =============================================================================
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# =============================================================================
# SECURITY HARDENING (production)
# =============================================================================
# IP whitelist (comma-separated, empty = allow all)
IP_WHITELIST=

# IP blacklist (comma-separated)
IP_BLACKLIST=

# Disable user self-registration
ALLOW_SELF_REGISTRATION=false

# Enforce 2FA for all users
ENFORCE_2FA=false

# Max login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# =============================================================================
# GENERATING SECRETS
# =============================================================================
# Run these commands to generate secure values:
#
# DB_PASSWORD:       openssl rand -base64 32
# REDIS_PASSWORD:    openssl rand -base64 32
# JWT_SECRET:        openssl rand -hex 32
# JWT_REFRESH_SECRET: openssl rand -hex 32
# ENCRYPTION_KEY:    openssl rand -hex 16  (exactly 32 chars)
# SESSION_SECRET:    openssl rand -hex 32
#
# Quick generate all:
# echo "DB_PASSWORD=$(openssl rand -base64 32)"
# echo "REDIS_PASSWORD=$(openssl rand -base64 32)"
# echo "JWT_SECRET=$(openssl rand -hex 32)"
# echo "JWT_REFRESH_SECRET=$(openssl rand -hex 32)"
# echo "ENCRYPTION_KEY=$(openssl rand -hex 16)"
# echo "SESSION_SECRET=$(openssl rand -hex 32)"
# =============================================================================
