# ===========================================
# AgentSmith Environment Configuration
# ===========================================
# Copy this file to .env and update the values

# Application
NODE_ENV=development
APP_NAME=AgentSmith
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Server
PORT=4000
HOST=0.0.0.0

# Frontend
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000

# Admin Panel
ADMIN_PORT=3001

# Database (PostgreSQL)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=agentsmith
DB_USERNAME=agentsmith
DB_PASSWORD=your_secure_password_here
DB_SSL=false

# Redis (for queues and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (for credentials storage)
ENCRYPTION_KEY=your_32_character_encryption_key

# Worker Configuration
WORKER_CONCURRENCY=5
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY=5000

# Webhook Configuration
WEBHOOK_URL=http://localhost:4000/webhooks

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./storage

# AWS S3 (optional - for cloud storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@agentsmith.local

# External Services (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Monitoring
SENTRY_DSN=
